# ===========================================
# Python
# ===========================================

__pycache__/
*.py[cod]
*$py.class

# Virtual environments
.venv/
venv/
env/

# ===========================================
# IDEs
# ===========================================

.vscode/
.idea/
*.iml

# ===========================================
# Python packaging
# ===========================================

build/
dist/
*.egg-info/

# ===========================================
# Model checkpoints
# ===========================================

*.pt
!models/yolo/best.pt

# ===========================================
# Dataset
# ===========================================

# Ignore dataset contents
data/raw/*
data/yolo/*
data/ocr/*

# Keep directory structure
!data/raw/.gitkeep
!data/yolo/.gitkeep
!data/ocr/.gitkeep

# Keep subdirectories
!data/raw/images/
!data/yolo/images/
!data/yolo/labels/
!data/ocr/images/

# Ignore their contents
data/raw/images/*
data/yolo/images/*
data/yolo/labels/*
data/ocr/images/*

# Keep folder structure
!data/raw/images/.gitkeep
!data/yolo/images/.gitkeep
!data/yolo/labels/.gitkeep
!data/ocr/images/.gitkeep

# Ignore generated files
data/raw/annotations.csv
data/yolo/data.yaml

# ===========================================
# Outputs
# ===========================================

outputs/*
!outputs/.gitkeep

# ===========================================
# Training runs
# ===========================================

runs/*
!runs/.gitkeep

# ===========================================
# Misc
# ===========================================

.DS_Store
Thumbs.db

# ===========================================
# Logs
# ===========================================

*.log